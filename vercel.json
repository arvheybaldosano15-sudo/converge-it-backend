{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://convergeitbackend-8c7v8t4n.b4a.run/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://convergeitbackend-8c7v8t4n.b4a.run/uploads/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://convergeitbackend-8c7v8t4n.b4a.run/socket.io/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
