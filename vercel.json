{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://converge-it-backend-rnpx.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://converge-it-backend-rnpx.onrender.com/uploads/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://converge-it-backend-rnpx.onrender.com/socket.io/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
